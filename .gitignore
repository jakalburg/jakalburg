# ── Root .gitignore for the Jakalburg monorepo (client / admin / server) ──
# Per-app rules live in client/.gitignore, admin/.gitignore, server/.gitignore.
# This file covers repo-root cruft and things that must never be pushed.

# Dependencies (any level)
node_modules/
.pnp
.pnp.*

# Env / secrets — never commit
.env
.env.*
!.env.example
!**/.env.example


# Build output / generated (any level)
.next/
out/
dist/
dist-ssr/
build/
.output/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local reference project (kept locally, not pushed)
reference/

# Scratch images / screenshots
image/

# Knowledge graph output (regenerate with `graphify update .`)
graphify-out/

# Claude Code local overrides (keep .claude/ and CLAUDE.md tracked)
.claude/settings.local.json

# OS / editor
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.sw?
