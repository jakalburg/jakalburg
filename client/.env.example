# ============================================
# Jakalburg CLIENT — Environment Variables
# ============================================
# Only NEXT_PUBLIC_* vars are used by the Next.js client (they are inlined into
# the browser bundle, so never put secrets here). The values below are safe to
# expose publicly.

# Backend API base URL (the NestJS server). Trailing slash / "/api" are stripped.
NEXT_PUBLIC_API_URL="http://localhost:8080"

# Google OAuth client ID for One Tap / "Sign in with Google".
# NOTE: the matching client SECRET belongs on the SERVER only — never here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
