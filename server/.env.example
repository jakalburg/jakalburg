# ============================================
# Jakalburg SERVER — Environment Variables
# ============================================

# Environment
NODE_ENV=development
PORT=8080
PRODUCTION_URL="https://server.jakalburgcreation.com"

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Initial admin (bootstrapped on server start)
ADMIN_EMAIL="admin@jakalburgcreation.com"
ADMIN_PASSWORD="change-this-admin-password"

# JWT (generate with: openssl rand -hex 64)
JWT_SECRET="change-this-super-secret-jwt-key"
JWT_EXPIRES_IN="30d"

# Google OAuth (One Tap). Jakalburg naming; OAUTH_CLIENT_ID/SECRET also accepted.
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Frontend URLs (comma-separated CORS allow-list)
FRONTEND_URL="http://localhost:3000"
FRONTEND_URL_PROD="https://www.jakalburgcreation.com,https://jakalburgcreation.com"

# SMTP (Gmail / Google Workspace by default — override host/port for other providers).
# SMTP_USER/SMTP_PASSWORD = the account we AUTHENTICATE as (must own the app password).
# SMTP_FROM_EMAIL = the address recipients SEE. To show a different vanity address than
# SMTP_USER (e.g. support@yourdomain via a gmail login), that vanity address must be added
# as a verified "Send mail as" alias in the authenticating Gmail account, or Gmail rewrites
# the visible From back to SMTP_USER.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_gmail_that_owns_the_app_password@gmail.com"
SMTP_PASSWORD="your_16_char_gmail_app_password"
SMTP_FROM_EMAIL="support@jakalburgcreation.com"
SMTP_FROM_NAME="Jakalburg"

# OTP policy
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Store branding (used in email templates)
STORE_NAME="Jakalburg"

# Swagger docs path (development only)
SWAGGER_PATH=/api-docs

# Cloudinary (present for future media features; unused by auth)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
