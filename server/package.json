{
  "name": "jakalburg-server",
  "private": true,
  "version": "1.0.0",
  "description": "Jakalburg Server TypeScript repository",
  "license": "MIT",
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:build": "node prisma/build-prisma-schema.js",
    "prisma:generate": "npm run prisma:build && prisma generate",
    "prisma:migrate": "npm run prisma:build && prisma db push",
    "prisma:studio": "npm run prisma:build && prisma studio",
    "db:seed": "npm run prisma:generate && prisma db seed"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\",\"moduleResolution\":\"Node\"} prisma/seed.ts"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.17",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.17.1",
    "@types/bcrypt": "^6.0.0",
    "@types/passport-jwt": "^4.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.10.1",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "multer": "^2.2.0",
    "nodemailer": "^7.0.9",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.13",
    "@types/nodemailer": "^7.0.2",
    "prettier": "^3.4.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2"
  }
}
