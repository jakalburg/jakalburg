// Admin-facing notifications: the bell in the admin header, and the
// preferences behind Settings → Notifications.
//
// Both are STORE-WIDE singletons rather than per-user rows. The toggles
// ("email me when a customer places an order", "email the customer when their
// order ships") are decisions about how the shop behaves, not personal
// preferences of whichever staff member is logged in — and the recipient of
// the owner email comes from Settings → Email, not from a user account. Keying
// them to a user id would also mean trusting the admin's session id, which is
// exactly the mock-auth value this screen used to depend on.

/// One entry in the admin's notification bell. Written by the server when
/// something happens to an order; read, marked read, and pruned here.
model Notification {
  id String @id @default(cuid())

  /// Event discriminator: order_placed | order_shipped | order_cancelled.
  /// A plain String rather than an enum so a new event type can be added
  /// without a migration against the shared production database.
  type String

  title   String
  message String
  /// Admin-relative path to open when the row is clicked (e.g. /orders/<id>).
  link    String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  /// The bell lists newest-first and counts unread; both are served by this.
  @@index([isRead, createdAt])
  /// Pruning old rows scans by age alone; the alerts table also sorts on it.
  @@index([createdAt])
  /// The alerts table's type filter, paired with the sort column.
  @@index([type, createdAt])
}

/// Singleton row holding the six toggles on Settings → Notifications.
///
/// Defaults are all `true` so that a store with no row yet behaves exactly
/// like one that has never touched the screen: every notification is sent.
/// The service also falls back to these defaults if the table can't be read,
/// so a database blip quietly degrades to "notify about everything" rather
/// than silently swallowing order alerts.
model NotificationSettings {
  id String @id @default(cuid())

  // ---- Email ----
  /// Gates the new-order email to the store owner.
  emailOrderPlaced    Boolean @default(true)
  /// Gates the status-update email to the CUSTOMER when an order ships.
  /// The per-order "Notify customer" checkbox still applies on top of this —
  /// both must be on for the mail to go out.
  emailOrderShipped   Boolean @default(true)
  /// Same, for a cancellation.
  emailOrderCancelled Boolean @default(true)

  // ---- In-app (the admin header bell) ----
  inAppOrderPlaced    Boolean @default(true)
  inAppOrderShipped   Boolean @default(true)
  inAppOrderCancelled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
