enum Gender {
  women
  men
  unisex
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  gender         Gender
  category       String
  price          Int // whole rupees (INR); the UI formats with Intl en-IN
  compareAtPrice Int? // original/strike-through price when on sale
  images         String[] // ordered image URLs; images[0] is the primary
  sizes          String[]
  soldOutSizes   String[] @default([])
  tags           String[] @default([])
  isNew          Boolean  @default(false)
  onSale         Boolean  @default(false)
  collection     String? // DEPRECATED legacy single slug; superseded by `collections`. Kept so existing rows aren't dropped; backfilled into `collections` on seed.
  collections    String[] @default([]) // collection slugs this product belongs to (many-to-many via slug; see model Collection)
  essential      Boolean  @default(false) // "featured"/essentials flag used on home + collections
  description    String
  fabric         String
  care           String
  stock          Int      @default(0) // simple inventory count for stock-state testing
  isActive       Boolean  @default(true) // storefront visibility gate; admin can hide a product without deleting it
  reviewsHidden  Boolean  @default(false) // when true, the storefront hides this product's reviews + rating (data is kept; toggled in bulk from the reviews dashboard)

  // Denormalized aggregates over APPROVED reviews only. Recomputed by
  // ReviewsService on every approve / reject / delete so the listing grid and
  // product cards can show stars without a join or a per-card count query.
  avgRating   Float @default(0) // 0 when there are no approved reviews
  reviewCount Int   @default(0)

  colors  ProductColor[]
  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gender])
  @@index([category])
  @@index([collection])
  @@index([isActive])
  // Paginated list ordering. The storefront always filters on isActive and
  // orders by createdAt (or price), so the sort can be served from the index
  // instead of sorting the whole matching set per page.
  @@index([isActive, createdAt])
  @@index([isActive, price])
  @@index([createdAt])
  @@index([price])
}

// Colour options for a product (the storefront's only real variant axis).
// Each colour is a full variant: it may carry its own images, sizes, sold-out
// set, price, compare-at and stock. Empty arrays / null mean "inherit the
// product-level default", so existing rows keep working with no backfill.
model ProductColor {
  id        String  @id @default(cuid())
  productId String
  name      String // e.g. "Ivory"
  hex       String // e.g. "#f4efe6"
  position  Int     @default(0) // display order

  images         String[] @default([]) // this colour's gallery; falls back to Product.images
  sizes          String[] @default([]) // this colour's sizes; falls back to Product.sizes
  soldOutSizes   String[] @default([]) // sold-out subset for this colour
  price          Int? // overrides Product.price when set
  compareAtPrice Int? // overrides Product.compareAtPrice when set
  stock          Int? // overrides Product.stock when set

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}
