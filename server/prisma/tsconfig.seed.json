{
  // ts-node config for the prisma/seed-*.ts scripts.
  //
  // The root tsconfig targets "nodenext", which ts-node runs as ESM — the seed
  // scripts are plain CommonJS and fail under it. Passing the override inline
  // (`--compiler-options {...}`) doesn't survive the shell stripping its
  // quotes, so it lives in a file instead.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "isolatedModules": false,
    "noEmit": true
  },
  "include": ["./**/*.ts"]
}
