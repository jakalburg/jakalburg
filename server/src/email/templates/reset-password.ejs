<!DOCTYPE html>
<html>

<head>
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }

    .header {
      background-color: #111111;
      color: #ffffff;
      padding: 24px 20px;
      text-align: center;
      border-radius: 8px 8px 0 0;
    }

    .header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: bold;
    }

    .content {
      background-color: #f9fafb;
      padding: 30px;
      border-radius: 0 0 8px 8px;
    }

    .cta {
      text-align: center;
      margin: 28px 0;
    }

    .button {
      display: inline-block;
      padding: 14px 32px;
      background-color: #111111;
      color: #ffffff !important;
      text-decoration: none !important;
      border-radius: 6px;
      font-weight: 700;
      font-size: 14px;
      line-height: 1.2;
    }

    .fallback {
      word-break: break-all;
      font-size: 12px;
      color: #6b7280;
    }

    .footer {
      margin-top: 20px;
      text-align: center;
      color: #6b7280;
      font-size: 14px;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="header">
      <h1><%= storeName %></h1>
    </div>
    <div class="content">
      <h2>Reset your password</h2>
      <p>Hi <%= name %>,</p>
      <p>We received a request to reset the password for your <%= storeName %> account. Click the button below to choose a new password.</p>
      <div class="cta">
        <a href="<%= resetUrl %>" class="button" bgcolor="#111111">Reset password</a>
      </div>
      <p><strong>This link will expire in <%= expiryMinutes %> minutes and can only be used once.</strong></p>
      <p>If the button doesn't work, copy and paste this link into your browser:</p>
      <p class="fallback"><%= resetUrl %></p>
      <p>If you didn't request this, you can safely ignore this email — your password won't change.</p>
    </div>
    <div class="footer">
      <p>&copy; <%= currentYear %> <%= storeName %>. All rights reserved.</p>
    </div>
  </div>
</body>

</html>
