<!DOCTYPE html>
<html>

<head>
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }

    .header {
      background-color: #111111;
      color: #ffffff;
      padding: 24px 20px;
      text-align: center;
      border-radius: 8px 8px 0 0;
    }

    .header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: bold;
    }

    .content {
      background-color: #f9fafb;
      padding: 30px;
      border-radius: 0 0 8px 8px;
    }

    .footer {
      margin-top: 20px;
      text-align: center;
      color: #6b7280;
      font-size: 14px;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="header">
      <h1><%= storeName %></h1>
    </div>
    <div class="content">
      <h2>Hi <%= name %>,</h2>
      <p>Your email has been verified and your <%= storeName %> account is ready.</p>
      <p>Happy shopping!</p>
    </div>
    <div class="footer">
      <p>&copy; <%= currentYear %> <%= storeName %>. All rights reserved.</p>
    </div>
  </div>
</body>

</html>
